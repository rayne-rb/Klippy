; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Klippy"
run/main_scene="res://features/pet/Klippy.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=30
run/low_processor_mode=true
config/icon="res://assets/icon.svg"

[autoload]

; The link to Klippy.Server. An autoload because every slice that wants to publish
; or react to an event needs it, and threading a reference through the pet to reach
; them would put the pet in the middle of traffic that is none of its business.
KlippyLink="*res://features/link/KlippyLink.gd"

[audio]

driver/driver="Dummy"

[display]

window/size/viewport_width=200
window/size/viewport_height=200
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[internationalization]

rendering/text_driver="Fallback"

[physics]

common/physics_ticks_per_second=30
2d/physics_engine="Dummy"
3d/physics_engine="Dummy"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
