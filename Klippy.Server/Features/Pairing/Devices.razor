@page "/devices"
@attribute [Authorize]
@using Klippy.Server.Features.Link
@implements IDisposable
@inject PairingService Pairing
@inject PairingNotifier Notifier
@inject LinkRegistry Registry
@inject AccountService Users

<PageTitle>Devices</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Devices</MudText>

<MudText Typo="Typo.body1" Class="mud-text-secondary mb-6">
    @if (_isAdmin)
    {
        <text>
            Every device on this server. Approving one puts it in your own group unless
            you hand it to another account below.
        </text>
    }
    else
    {
        <text>
            The devices in your group. Approving a device is what makes it yours: it can
            then see your clipboard and reach your other devices, and nobody else's.
        </text>
    }
</MudText>

<MudText Typo="Typo.h6" Class="mt-6">Waiting to pair</MudText>

@if (_pending.Count == 0)
{
    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" NoIcon="true" Class="mt-2">
        Nothing is asking to pair. Launch Klippy or the phone app on this network and it
        will show up here on its own.
    </MudAlert>
}
else
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 mb-2">
        Check the code below matches the one on the device before approving it.
    </MudText>

    <MudTable Items="_pending" Dense="true" Hover="true" Elevation="0" Outlined="true"
              Breakpoint="Breakpoint.Sm" T="PairingRequestRow">
        <HeaderContent>
            <MudTh>Code</MudTh>
            <MudTh>Device</MudTh>
            <MudTh>Platform</MudTh>
            <MudTh>Expires</MudTh>
            <MudTh Style="text-align: right">Decision</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Code">
                <MudText Typo="Typo.h6"><code>@context.Code</code></MudText>
            </MudTd>
            <MudTd DataLabel="Device">
                <strong>@context.DeviceName</strong>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ml-1">
                    @context.DeviceKind
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Platform" Class="mud-text-secondary">@context.Platform</MudTd>
            <MudTd DataLabel="Expires" Class="mud-text-secondary">@Remaining(context.ExpiresAt)</MudTd>
            <MudTd DataLabel="Decision" Style="text-align: right">
                <MudButton Size="Size.Small"
                           Variant="Variant.Filled"
                           Color="Color.Success"
                           OnClick="() => ApproveAsync(context.RequestId)">
                    Approve
                </MudButton>
                <MudButton Size="Size.Small"
                           Variant="Variant.Outlined"
                           Color="Color.Error"
                           Class="ml-1"
                           OnClick="() => DenyAsync(context.RequestId)">
                    Deny
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<MudText Typo="Typo.h6" Class="mt-8">Paired</MudText>

@if (_devices.Count == 0)
{
    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" NoIcon="true" Class="mt-2">
        No devices paired yet.
    </MudAlert>
}
else
{
    <MudTable Items="_devices" Dense="true" Hover="true" Elevation="0" Outlined="true"
              Breakpoint="Breakpoint.Sm" Class="mt-2" T="PairedDeviceView">
        <HeaderContent>
            <MudTh></MudTh>
            <MudTh>Device</MudTh>
            @if (_isAdmin)
            {
                <MudTh>Owner</MudTh>
            }
            <MudTh>Platform</MudTh>
            <MudTh>Paired</MudTh>
            <MudTh>Last seen</MudTh>
            <MudTh Style="text-align: right"></MudTh>
        </HeaderContent>
        <RowTemplate>
            @{
                var online = Registry.IsConnected(context.DeviceId);
            }
            <MudTd DataLabel="Status">
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Filled"
                         Color="@(online ? Color.Success : Color.Default)">
                    @(online ? "online" : "offline")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Device">
                <strong>@context.DeviceName</strong>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ml-1">
                    @context.DeviceKind
                </MudChip>
            </MudTd>
            @if (_isAdmin)
            {
                <MudTd DataLabel="Owner">
                    @* A device with no owner is stranded in a group of one - it happens
                       when its account is removed - so an admin needs a way to put it
                       back somewhere without unpairing it. *@
                    <MudSelect T="Guid?"
                               Value="context.OwnerUserId"
                               ValueChanged="owner => ReassignAsync(context, owner)"
                               Dense="true"
                               Margin="Margin.Dense"
                               Variant="Variant.Text"
                               Style="min-width: 8rem">
                        <MudSelectItem T="Guid?" Value="@(null)">
                            <em>nobody</em>
                        </MudSelectItem>
                        @foreach (var account in _accounts)
                        {
                            <MudSelectItem T="Guid?" Value="@account.UserId">@account.Username</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>
            }
            <MudTd DataLabel="Platform" Class="mud-text-secondary">@context.Platform</MudTd>
            <MudTd DataLabel="Paired" Class="mud-text-secondary">
                @context.PairedAt.LocalDateTime.ToString("g")
            </MudTd>
            <MudTd DataLabel="Last seen" Class="mud-text-secondary">
                @(context.LastSeenAt?.LocalDateTime.ToString("g") ?? "never")
            </MudTd>
            <MudTd DataLabel="" Style="text-align: right">
                <MudButton Size="Size.Small"
                           Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.LinkOff"
                           OnClick="() => RevokeAsync(context.DeviceId)">
                    Unpair
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private IReadOnlyList<PairingRequestRow> _pending = [];
    private IReadOnlyList<PairedDeviceView> _devices = [];
    private IReadOnlyList<AccountSummary> _accounts = [];

    private Guid? _accountId;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _accountId = user.AccountId();
        _isAdmin = user.IsAdmin();

        Notifier.Changed += OnChanged;
        Registry.ConnectionsChanged += OnChanged;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _pending = await Pairing.GetOpenRequestsAsync(CancellationToken.None);

        // An admin sees the whole server; everyone else sees their own group and has no
        // way to ask for anyone else's.
        _devices = await Pairing.GetDeviceViewsAsync(_isAdmin ? null : _accountId, CancellationToken.None);

        if (_isAdmin)
        {
            _accounts = await Users.GetSummariesAsync(CancellationToken.None);
        }
    }

    // Raised from a request thread or a socket thread, so hop back onto the circuit
    // before touching component state.
    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    /// <summary>
    /// Approving is what hands the device to an account — this one. The pairing code is
    /// still the only secret involved, exactly as before; all that is added is whose the
    /// device becomes.
    /// </summary>
    private async Task ApproveAsync(Guid requestId)
    {
        await Pairing.ApproveAsync(requestId, _accountId, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task ReassignAsync(PairedDeviceView device, Guid? ownerUserId)
    {
        if (ownerUserId is { } owner)
        {
            await Users.AssignDeviceAsync(device.DeviceId, owner, CancellationToken.None);
        }
        else
        {
            await Users.ReleaseDeviceAsync(device.DeviceId, CancellationToken.None);
        }

        // A live connection carries the owner it was opened with (see LinkConnection), so
        // the change only means anything once the device comes back. Hang up and let it
        // reconnect rather than leave it routing to its old group.
        await Registry.DisconnectAsync(device.DeviceId);

        await ReloadAsync();
    }

    private async Task DenyAsync(Guid requestId)
    {
        await Pairing.DenyAsync(requestId, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task RevokeAsync(Guid deviceId)
    {
        await Pairing.RevokeAsync(deviceId, CancellationToken.None);
        await ReloadAsync();
    }

    private static string Remaining(DateTimeOffset expiresAt)
    {
        var left = expiresAt - DateTimeOffset.UtcNow;
        return left <= TimeSpan.Zero ? "expired" : $"in {left.Minutes}m {left.Seconds}s";
    }

    public void Dispose()
    {
        Notifier.Changed -= OnChanged;
        Registry.ConnectionsChanged -= OnChanged;
    }
}
