@page "/devices"
@rendermode InteractiveServer
@using Klippy.Server.Features.Link
@implements IDisposable
@inject PairingService Pairing
@inject PairingNotifier Notifier
@inject LinkRegistry Registry

<PageTitle>Devices</PageTitle>

<h1>Devices</h1>

<section class="mb-5">
    <h2 class="h4">Waiting to pair</h2>

    @if (_pending.Count == 0)
    {
        <p class="text-body-secondary">
            Nothing is asking to pair. Launch Klippy or the phone app on this network and it
            will show up here on its own.
        </p>
    }
    else
    {
        <p class="text-body-secondary">
            Check the code below matches the one on the device before approving it.
        </p>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>Code</th>
                    <th>Device</th>
                    <th>Platform</th>
                    <th>Expires</th>
                    <th class="text-end">Decision</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var request in _pending)
                {
                    <tr>
                        <td><code class="fs-4 fw-bold">@request.Code</code></td>
                        <td>
                            <strong>@request.DeviceName</strong>
                            <span class="badge text-bg-secondary ms-1">@request.DeviceKind</span>
                        </td>
                        <td class="text-body-secondary">@request.Platform</td>
                        <td class="text-body-secondary">@Remaining(request.ExpiresAt)</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-success"
                                    @onclick="() => ApproveAsync(request.RequestId)">Approve</button>
                            <button class="btn btn-sm btn-outline-danger ms-1"
                                    @onclick="() => DenyAsync(request.RequestId)">Deny</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section>
    <h2 class="h4">Paired</h2>

    @if (_devices.Count == 0)
    {
        <p class="text-body-secondary">No devices paired yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th></th>
                    <th>Device</th>
                    <th>Platform</th>
                    <th>Paired</th>
                    <th>Last seen</th>
                    <th class="text-end"></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var device in _devices)
                {
                    var online = Registry.IsConnected(device.DeviceId);
                    <tr>
                        <td>
                            <span class="badge @(online ? "text-bg-success" : "text-bg-secondary")">
                                @(online ? "online" : "offline")
                            </span>
                        </td>
                        <td>
                            <strong>@device.DeviceName</strong>
                            <span class="badge text-bg-secondary ms-1">@device.DeviceKind</span>
                        </td>
                        <td class="text-body-secondary">@device.Platform</td>
                        <td class="text-body-secondary">@device.PairedAt.LocalDateTime.ToString("g")</td>
                        <td class="text-body-secondary">
                            @(device.LastSeenAt?.LocalDateTime.ToString("g") ?? "never")
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => RevokeAsync(device.DeviceId)">Unpair</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private IReadOnlyList<PairingRequestRow> _pending = [];
    private IReadOnlyList<PairedDeviceRow> _devices = [];

    protected override async Task OnInitializedAsync()
    {
        Notifier.Changed += OnChanged;
        Registry.ConnectionsChanged += OnChanged;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _pending = await Pairing.GetOpenRequestsAsync(CancellationToken.None);
        _devices = await Pairing.GetDevicesAsync(CancellationToken.None);
    }

    // Raised from a request thread or a socket thread, so hop back onto the circuit
    // before touching component state.
    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    private async Task ApproveAsync(Guid requestId)
    {
        await Pairing.ApproveAsync(requestId, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task DenyAsync(Guid requestId)
    {
        await Pairing.DenyAsync(requestId, CancellationToken.None);
        await ReloadAsync();
    }

    private async Task RevokeAsync(Guid deviceId)
    {
        await Pairing.RevokeAsync(deviceId, CancellationToken.None);
        await ReloadAsync();
    }

    private static string Remaining(DateTimeOffset expiresAt)
    {
        var left = expiresAt - DateTimeOffset.UtcNow;
        return left <= TimeSpan.Zero ? "expired" : $"in {left.Minutes}m {left.Seconds}s";
    }

    public void Dispose()
    {
        Notifier.Changed -= OnChanged;
        Registry.ConnectionsChanged -= OnChanged;
    }
}
