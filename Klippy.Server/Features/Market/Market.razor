@page "/market"
@implements IDisposable
@inject MarketRepository MarketRepo
@inject MarketNotifier Notifier

<PageTitle>Market</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Market</MudText>

<MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" NoIcon="true" Class="mb-4">
    A view of what's for sale. Selling and buying happen on the Klippy desktop app itself
    — right-click Klippy, once he's connected to this server.
</MudAlert>

@if (_listings.Count == 0)
{
    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" NoIcon="true">
        Nothing is for sale right now.
    </MudAlert>
}
else
{
    <MudTable Items="_listings" Dense="true" Hover="true" Elevation="0" Outlined="true"
              Breakpoint="Breakpoint.Sm" T="MarketListingView">
        <HeaderContent>
            <MudTh>Item</MudTh>
            <MudTh>Price</MudTh>
            <MudTh>Seller</MudTh>
            <MudTh>Listed</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Item">@Humanize(context.ItemType)</MudTd>
            <MudTd DataLabel="Price">@context.Price KP</MudTd>
            <MudTd DataLabel="Seller" Class="mud-text-secondary">@context.SellerDeviceName</MudTd>
            <MudTd DataLabel="Listed" Class="mud-text-secondary">@context.ListedAt.LocalDateTime.ToString("g")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private IReadOnlyList<MarketListingView> _listings = [];

    protected override async Task OnInitializedAsync()
    {
        Notifier.Changed += OnChanged;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _listings = await MarketRepo.GetActiveListingsAsync(CancellationToken.None);
    }

    // Raised from whichever HTTP request just sold or listed something, so hop back
    // onto this circuit before touching component state.
    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    private static string Humanize(string itemType) =>
        itemType.Length == 0
            ? itemType
            : char.ToUpperInvariant(itemType[0]) + itemType[1..].Replace('_', ' ');

    public void Dispose()
    {
        Notifier.Changed -= OnChanged;
    }
}
