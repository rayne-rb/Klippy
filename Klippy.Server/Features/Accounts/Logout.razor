@page "/logout"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@inject NavigationManager Nav

@* Signing out clears a cookie, so this page is static SSR like the other two. It asks
   first rather than signing out on the way in: a plain link that logged you out could be
   triggered by anything that gets your browser to follow it. *@

<PageTitle>Sign out</PageTitle>

<MudPaper Class="pa-6" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true">Sign out of Klippy?</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        Your devices stay paired and keep working. This only signs this browser out.
    </MudText>

    <EditForm Model="this" FormName="logout" OnValidSubmit="SignOutAsync">
        <button type="submit" class="klippy-submit">Sign out</button>
    </EditForm>

    <MudText Typo="Typo.body2" Class="mt-4">
        <MudLink Href="/">Stay signed in</MudLink>
    </MudText>
</MudPaper>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private async Task SignOutAsync()
    {
        await HttpContext.SignOutAsync(AccountPrincipal.Scheme);
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
