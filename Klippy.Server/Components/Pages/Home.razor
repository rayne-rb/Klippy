@page "/"
@attribute [Authorize]
@using Klippy.Server.Common
@using Klippy.Server.Features.Link
@implements IDisposable
@inject ServerIdentity Identity
@inject LinkRegistry Registry

<PageTitle>Klippy</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@Identity.Name</MudText>

<MudText Typo="Typo.body1" Class="mud-text-secondary mb-6">
    This server holds Klippy together: it stores the data, runs the skills, and relays
    events between the desktop companion and the phone.
</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-4 d-flex flex-column" Style="height: 100%" Outlined="true">
            <MudText Typo="Typo.overline" Class="mud-text-secondary">Reachable at</MudText>
            <MudText Typo="Typo.h6" Class="mt-1" Style="word-break: break-all;">
                <code>@Identity.BaseUrl</code>
            </MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-auto pt-2">
                Devices on this network find that address by themselves. There is nothing to type in.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-4 d-flex flex-column" Style="height: 100%" Outlined="true">
            <MudText Typo="Typo.overline" Class="mud-text-secondary">Connected</MudText>
            <MudText Typo="Typo.h3" Class="mt-1">@_connected</MudText>
            <div class="mt-auto pt-2">
                <MudLink Href="devices" Typo="Typo.caption">Manage devices</MudLink>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>
    /// Devices online. An admin counts the server; anyone else counts their own account,
    /// the same set they can actually see on the Devices page.
    /// </summary>
    private int _connected;

    private Guid? _accountId;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _accountId = user.AccountId();
        _isAdmin = user.IsAdmin();

        Registry.ConnectionsChanged += OnChanged;
        Count();
    }

    private void Count() =>
        _connected = _isAdmin
            ? Registry.Connections.Count
            : _accountId is { } owner ? Registry.DeviceIdsInGroup(owner).Count : 0;

    // Raised from a socket thread, so hop back onto the circuit before touching state.
    private void OnChanged() => _ = InvokeAsync(() =>
    {
        Count();
        StateHasChanged();
    });

    public void Dispose() => Registry.ConnectionsChanged -= OnChanged;
}
