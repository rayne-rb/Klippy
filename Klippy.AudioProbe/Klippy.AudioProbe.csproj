<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Klippy.AudioProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klippy.Shared\Klippy.Shared.csproj" />
    <!-- The capture sources live in the server's AudioCast slice. Exercising the real
         ones is the entire point: a probe with its own copy would prove nothing. -->
    <ProjectReference Include="..\Klippy.Server\Klippy.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed to consume a Microsoft.NET.Sdk.Web project from a plain console app. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
